<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:CareerCounsellingApp.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1300" d:DesignHeight="700"
        x:Class="CareerCounsellingApp.AdminDashboardWindow"
        x:DataType="vm:AdminDashboardViewModel"
        Title="Admin Dashboard"
        WindowState="Maximized"
        Background="#E8EEF7"
        WindowStartupLocation="CenterScreen">

    <Grid ColumnDefinitions="280,*" RowDefinitions="Auto,*">
        <!-- Header - Modern Glass -->
        <Border Grid.ColumnSpan="2"
                Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="#E2E8F0"
                BorderThickness="0,0,0,1"
                Padding="30,20"
                BoxShadow="0 4 12 #00000008">
            <Grid
                ColumnDefinitions="*,Auto"
                Margin="10">

                <StackPanel>

                    <TextBlock
                        Text="Admin Dashboard"
                        FontSize="30"
                        FontWeight="Bold"
                        Foreground="#1A202C"
                        LetterSpacing="0.3"/>

                    <TextBlock
                        Text="Manage students, questions and assessments"
                        Foreground="#718096"
                        FontSize="14"
                        Margin="0,4,0,0"/>

                </StackPanel>

                <Button
                    Grid.Column="1"
                    CornerRadius="12"
                    Width="46"
                    Height="46"
                    Background="#F7FAFC"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    VerticalAlignment="Center">

                    <TextBlock
                        Text="🔄"
                        FontSize="20"/>

                </Button>

            </Grid>
        </Border>

        <!-- Sidebar - Modern Glass Dark -->
        <Border
            Grid.Column="0"
            Grid.RowSpan="2"
            Grid.Row="1"
            Background="#1A3A5C">

            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="#1E3A5C"/>
                    <GradientStop Offset="1" Color="#152847"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid RowDefinitions="Auto,*,Auto">

                <!-- Branding -->
                <StackPanel
                    Margin="20"
                    HorizontalAlignment="Center"
                    Spacing="8">

                    <Image
                        Source="/Assets/logo.png"
                        Width="120"
                        Height="150"
                        Opacity="0.95"/>

                    <TextBlock
                        Text="Career Counselling"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="White"
                        HorizontalAlignment="Center"
                        LetterSpacing="0.2"/>

                    <TextBlock
                        Text="Administration"
                        FontSize="13"
                        Foreground="#A0AEC0"
                        HorizontalAlignment="Center"/>

                </StackPanel>

                <!-- Navigation -->
                <StackPanel Grid.Row="1"
                            Margin="10,20,10,0"
                            Spacing="8">
                    <StackPanel Spacing="3">
                        <Button
                            Name="CategoryButton"
                            Height="52"
                            Width="260"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="12"
                            HorizontalContentAlignment="Left"
                            Padding="18,0"
                            Foreground="White"
                            Cursor="Hand">

                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="12">

                                <TextBlock
                                    Text="📂"
                                    FontSize="18"/>

                                <TextBlock
                                    Text="Manage Categories"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="White"/>

                            </StackPanel>

                        </Button>

                        <Button Name="QuestionButton"
                                Height="52"
                                Background="Transparent"
                                CornerRadius="12"
                                Width="260"
                                Foreground="White"
                                BorderThickness="0"
                                Margin="0"
                                Padding="18,0"
                                HorizontalContentAlignment="Left"
                                Cursor="Hand"
                                ToolTip.Tip="Add and manage assessment questions">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="12">

                                <TextBlock
                                    Text="📝"
                                    FontSize="18"/>

                                <TextBlock
                                    Text="Manage Questions"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="White"/>

                            </StackPanel>
                        </Button>

                        <Button Name="StudentButton"
                                Height="52"
                                Background="Transparent"
                                Foreground="White"
                                BorderThickness="0"
                                Margin="0"
                                Padding="18,0"
                                HorizontalContentAlignment="Left"
                                Cursor="Hand"
                                CornerRadius="12"
                                Width="260"
                                ToolTip.Tip="Manage student information">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="12">

                                <TextBlock
                                    Text="👨‍🎓"
                                    FontSize="18"/>

                                <TextBlock
                                    Text="Manage Students"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="White"/>

                            </StackPanel>
                        </Button>

                        <Button Name="AssessmentResultsButton"
                                Height="52"
                                Width="260"
                                Foreground="White"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="18,0"
                                HorizontalContentAlignment="Left"
                                Cursor="Hand"
                                CornerRadius="12"
                                ToolTip.Tip="View student assessment results and scores">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="12">

                                <TextBlock
                                    Text="📊"
                                    FontSize="18"/>

                                <TextBlock
                                    Text="Assessment Results"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="White"/>

                            </StackPanel>
                        </Button>

                        <Button Height="52"
                                Foreground="White"
                                BorderThickness="0"
                                Padding="18,0"
                                Background="Transparent"
                                Width="260"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Cursor="Hand"
                                Name="ReportsButton"
                                CornerRadius="12"
                                ToolTip.Tip="Generate system reports">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="12">

                                <TextBlock
                                    Text="📈"
                                    FontSize="18"/>

                                <TextBlock
                                    Text="Reports"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="White"/>

                            </StackPanel>
                        </Button>

                        <Separator Height="1" Background="White" Opacity="0.15" Margin="0,20"/>

                        <Button Name="LogoutButton"
                                Height="52"
                                Background="Transparent"
                                Width="260"
                                Foreground="White"
                                BorderThickness="0"
                                Margin="0"
                                Padding="18,0"
                                HorizontalContentAlignment="Left"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                CornerRadius="12"
                                ToolTip.Tip="Logout and return to login screen">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="12">

                                <TextBlock
                                    Text="🚪"
                                    FontSize="18"/>

                                <TextBlock
                                    Text="Logout"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="White"/>

                            </StackPanel>
                        </Button>
                    </StackPanel>

                </StackPanel>

            </Grid>

        </Border>

        <!-- Main Content Area - Modern Glass -->
        <Border Grid.Column="1"
                Grid.Row="1"
                Background="#E8EEF7"
                Padding="40">
            <ScrollViewer>
                <StackPanel Spacing="30">
                    <!-- Welcome Section -->
                    <StackPanel Spacing="10">
                        <TextBlock Text="Welcome to Admin Dashboard"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="#1A202C"
                                   LetterSpacing="0.3"/>
                        <TextBlock Text="Here's an overview of your Career Counselling System"
                                   FontSize="16"
                                   Foreground="#718096"
                                   LineHeight="1.4"/>
                    </StackPanel>

                    <!-- Statistics Grid -->
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="20" RowSpacing="20">

                        <!-- Total Students Card -->
                        <Border Grid.Row="0"
                                Grid.Column="0"
                                Background="White"
                                CornerRadius="16"
                                Padding="28"
                                MinHeight="180"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                BoxShadow="0 10 30 #2563EB08, 0 2 4 #00000006">

                            <StackPanel Spacing="18">

                                <Grid ColumnDefinitions="Auto,*">

                                    <Border Width="55"
                                            Height="55"
                                            Background="#EFF6FF"
                                            CornerRadius="14">

                                        <TextBlock
                                            Text="👨‍🎓"
                                            FontSize="26"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>

                                    </Border>

                                    <StackPanel Grid.Column="1"
                                                Margin="15,0,0,0">

                                        <TextBlock
                                            Text="Total Students"
                                            FontSize="18"
                                            FontWeight="SemiBold"
                                            Foreground="#1A202C"/>

                                        <TextBlock
                                            Text="Registered Students"
                                            FontSize="12"
                                            Foreground="#A0AEC0"/>

                                    </StackPanel>

                                </Grid>

                                <TextBlock
                                    Text="{Binding TotalStudents}"
                                    FontSize="52"
                                    FontWeight="Bold"
                                    Foreground="#2563EB"/>

                            </StackPanel>

                        </Border>

                        <!-- Students Assessed Card -->
                        <Border Grid.Row="0"
                                Grid.Column="1"
                                Background="White"
                                CornerRadius="16"
                                Padding="28"
                                MinHeight="180"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                BoxShadow="0 10 30 #10B98108, 0 2 4 #00000006">

                            <StackPanel Spacing="18">

                                <Grid ColumnDefinitions="Auto,*">

                                    <Border Width="55"
                                            Height="55"
                                            Background="#F0FDF4"
                                            CornerRadius="14">

                                        <TextBlock
                                            Text="✅"
                                            FontSize="24"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>

                                    </Border>

                                    <StackPanel Grid.Column="1"
                                                Margin="15,0,0,0">

                                        <TextBlock
                                            Text="Students Assessed"
                                            FontSize="18"
                                            FontWeight="SemiBold"
                                            Foreground="#1A202C"/>

                                        <TextBlock
                                            Text="Completed Assessment"
                                            FontSize="12"
                                            Foreground="#A0AEC0"/>

                                    </StackPanel>

                                </Grid>

                                <TextBlock
                                    Text="{Binding StudentsAssessed}"
                                    FontSize="52"
                                    FontWeight="Bold"
                                    Foreground="#10B981"/>

                            </StackPanel>

                        </Border>

                        <!-- Total Questions Card -->
                        <Border Grid.Row="1"
                                Grid.Column="0"
                                Background="White"
                                CornerRadius="16"
                                Padding="28"
                                MinHeight="180"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                BoxShadow="0 10 30 #F59E0B08, 0 2 4 #00000006">

                            <StackPanel Spacing="18">

                                <Grid ColumnDefinitions="Auto,*">

                                    <Border Width="55"
                                            Height="55"
                                            Background="#FFFBEB"
                                            CornerRadius="14">

                                        <TextBlock
                                            Text="📝"
                                            FontSize="24"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>

                                    </Border>

                                    <StackPanel Grid.Column="1"
                                                Margin="15,0,0,0">

                                        <TextBlock
                                            Text="Total Questions"
                                            FontSize="18"
                                            FontWeight="SemiBold"
                                            Foreground="#1A202C"/>

                                        <TextBlock
                                            Text="Assessment Questions"
                                            FontSize="12"
                                            Foreground="#A0AEC0"/>

                                    </StackPanel>

                                </Grid>

                                <TextBlock
                                    Text="{Binding TotalQuestions}"
                                    FontSize="52"
                                    FontWeight="Bold"
                                    Foreground="#F59E0B"/>

                            </StackPanel>

                        </Border>

                        <!-- Total Categories Card -->
                        <Border Grid.Row="1"
                                Grid.Column="1"
                                Background="White"
                                CornerRadius="16"
                                Padding="28"
                                MinHeight="180"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                BoxShadow="0 10 30 #8B5CF608, 0 2 4 #00000006">

                            <StackPanel Spacing="18">

                                <Grid ColumnDefinitions="Auto,*">

                                    <Border Width="55"
                                            Height="55"
                                            Background="#F3E8FF"
                                            CornerRadius="14">

                                        <TextBlock
                                            Text="📂"
                                            FontSize="24"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>

                                    </Border>

                                    <StackPanel Grid.Column="1"
                                                Margin="15,0,0,0">

                                        <TextBlock
                                            Text="Total Categories"
                                            FontSize="18"
                                            FontWeight="SemiBold"
                                            Foreground="#1A202C"/>

                                        <TextBlock
                                            Text="Career Categories"
                                            FontSize="12"
                                            Foreground="#A0AEC0"/>

                                    </StackPanel>

                                </Grid>

                                <TextBlock
                                    Text="{Binding TotalCategories}"
                                    FontSize="52"
                                    FontWeight="Bold"
                                    Foreground="#8B5CF6"/>

                            </StackPanel>

                        </Border>

                    </Grid>

                    <!-- Additional Info Section -->
                    <Border Background="White"
                            Padding="28"
                            CornerRadius="16"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            BoxShadow="0 4 12 #00000008">
                        <StackPanel Spacing="18">
                            <TextBlock Text="Quick Actions"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#1A202C"/>
                            <TextBlock Text="Use the navigation menu on the left to manage categories, questions, students, and view assessment results."
                                       FontSize="14"
                                       Foreground="#718096"
                                       TextWrapping="Wrap"
                                       LineHeight="1.6"/>
                            <Separator Height="1.5" Background="#E2E8F0" Margin="0,5,0,0"/>
                            <TextBlock Text="💡 Tip: Ensure all required data is properly configured before students begin their assessments."
                                       FontSize="13"
                                       Foreground="#2563EB"
                                       TextWrapping="Wrap"
                                       FontWeight="SemiBold"
                                       LineHeight="1.5"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
