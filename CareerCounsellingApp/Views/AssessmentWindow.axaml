<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
    x:Class="CareerCounsellingApp.AssessmentWindow"
    xmlns:model="using:CareerCounsellingApp.Models"
    xmlns:vm="using:CareerCounsellingApp.ViewModels"
    xmlns:converters="using:CareerCounsellingApp.Converters"
    x:DataType="vm:AssessmentViewModel"
    Width="1000"
    Height="800"
    Title="Career Assessment"
    Background="#E8EEF7"
    WindowStartupLocation="CenterScreen">

<Window.Resources>
    <converters:ObjectEqualityConverter x:Key="ObjectEqualityConverter"/>
	<converters:LanguageConverter x:Key="LanguageConverter"/>
</Window.Resources>
    
<DockPanel Name="DockPanelMain">
      <!-- Header - Modern Glass -->
      <Border DockPanel.Dock="Top"
              Background="White"
              BorderBrush="#E2E8F0"
              BorderThickness="0,0,0,1"
              Padding="30,20"
              BoxShadow="0 4 12 #00000008">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
          <!-- Previous Button -->
          <Button Grid.Column="0"
                  Command="{Binding PreviousQuestionCommand}"
                  Width="46"
                  Height="46"
                  CornerRadius="12"
                  Background="#F7FAFC"
                  Foreground="#2563EB"
                  BorderThickness="1"
                  BorderBrush="#E2E8F0"
                  ToolTip.Tip="Previous Question"
                  Cursor="Hand">
            <TextBlock Text="◀" FontSize="18" FontWeight="Bold"/>
          </Button>

          <!-- Title and Progress Info -->
          <StackPanel Grid.Column="1" Margin="30,0,20,0" VerticalAlignment="Center">
            <TextBlock Text="Career Assessment"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#1A202C"
                       LetterSpacing="0.3"/>
            <TextBlock Text="{Binding CurrentQuestionNumber, StringFormat='Question {0} of '}"
                       FontSize="13"
                       Foreground="#718096"
                       Opacity="0.9"
                       Margin="0,4,0,0"/>
          </StackPanel>

          <!-- Language Toggle -->
          <Border Grid.Column="2"
                  Width="160"
                  Height="40"
                  CornerRadius="12"
                  Background="#F7FAFC"
                  BorderBrush="#E2E8F0"
                  BorderThickness="1"
                  Padding="4"
                  VerticalAlignment="Center"
                  BoxShadow="0 2 4 #00000008">
            <Grid ColumnDefinitions="*,*">
              <!-- Selected background -->
              <Border Grid.Column="0"
                      CornerRadius="10"
                      Background="#2563EB">
                <Border.IsVisible>
                  <Binding Path="!UseMalayalam"/>
                </Border.IsVisible>
              </Border>

              <Border Grid.Column="1"
                      CornerRadius="10"
                      Background="#2563EB">
                <Border.IsVisible>
                  <Binding Path="UseMalayalam"/>
                </Border.IsVisible>
              </Border>

              <ToggleButton Grid.Column="0"
                            IsChecked="{Binding !UseMalayalam}"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#1A202C"
                            FontSize="12"
                            FontWeight="SemiBold">
                <TextBlock Text="English"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
              </ToggleButton>

              <ToggleButton Grid.Column="1"
                            IsChecked="{Binding UseMalayalam}"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#1A202C"
                            FontSize="12"
                            FontWeight="SemiBold">
                <TextBlock Text="മലയാളം"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
              </ToggleButton>
            </Grid>
          </Border>
          
          <!-- Next Button -->
          <Button Grid.Column="3"
                  Command="{Binding NextQuestionCommand}"
                  Width="46"
                  Height="46"
                  CornerRadius="12"
                  Background="#F7FAFC"
                  Foreground="#2563EB"
                  BorderThickness="1"
                  BorderBrush="#E2E8F0"
                  ToolTip.Tip="Next Question"
                  Cursor="Hand"
                  Margin="20,0,0,0">
            <TextBlock Text="▶" FontSize="18" FontWeight="Bold"/>
          </Button>
        </Grid>
      </Border>

      <!-- Submit Button -->
      <Border DockPanel.Dock="Bottom"
              Background="White"
              BorderBrush="#E2E8F0"
              BorderThickness="0,1,0,0"
              Padding="30,20"
              BoxShadow="0 -4 12 #00000008">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
          <!-- Progress Section -->
          <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="10">
            <TextBlock Text="Overall Progress"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#1A202C"/>
            <TextBlock Text="{Binding ProgressText}"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="#2563EB"/>
            <ProgressBar Value="{Binding AnsweredCount}"
                         Maximum="{Binding TotalQuestions}"
                         Height="6"
                         CornerRadius="3"
                         Foreground="#2563EB"
                         Background="#E8EEF7"/>
          </StackPanel>

          <!-- Submit Button -->
          <Button Grid.Column="1"
                  Height="46"
                  Foreground="White"
                  FontSize="15"
                  FontWeight="SemiBold"
                  Command="{Binding SubmitAssessmentCommand}"
                  Cursor="Hand"
                  Classes="primary"
                  CornerRadius="12">
            <TextBlock Text="✓ Submit Assessment"/>
          </Button>
        </Grid>
      </Border>

      <!-- Questions Content - Single Question at a Time -->
	<!-- Questions Content -->
	<Border DockPanel.Dock="Top"
			Padding="30"
			Background="#E8EEF7">

		<ScrollViewer
			VerticalScrollBarVisibility="Auto"
			HorizontalScrollBarVisibility="Disabled">

			<ContentControl Content="{Binding CurrentQuestion}">

				<ContentControl.ContentTemplate>
					<DataTemplate x:DataType="model:AssessmentQuestion">

						<Border Padding="40"
								Background="White"
								BorderBrush="#E2E8F0"
								BorderThickness="1"
								CornerRadius="16"
								BoxShadow="0 8 24 #2563EB08, 0 2 4 #00000006">

							<StackPanel Spacing="25">

								<!-- Question Number -->
								<TextBlock
									Text="{Binding Number,
                                       StringFormat='Question {0}'}"
									FontSize="16"
									FontWeight="Bold"
									Foreground="{StaticResource PrimaryBrush}"/>

								<!-- Question Text -->
								<TextBlock
									Text="{Binding DisplayQuestionText}"
									FontSize="22"
									FontWeight="SemiBold"
									Foreground="{StaticResource TextPrimaryBrush}"
									TextWrapping="Wrap"/>

								<!-- Image -->
								<Image
									Source="{Binding QuestionImage}"
									MaxHeight="400"
									Stretch="Uniform"
									IsVisible="{Binding HasQuestionImage}"/>

								<!-- Options -->
								<ItemsControl ItemsSource="{Binding Options}">

									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<StackPanel Spacing="10"/>
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>

									<ItemsControl.ItemTemplate>
										<DataTemplate
											x:DataType="model:AssessmentOption">

											<RadioButton
												GroupName="{Binding Option.QuestionId}"
												Tag="{Binding Option}"
												Click="RadioButton_Click"
												Padding="12">

												<TextBlock
													Text="{Binding DisplayText}"
													FontSize="16"
													TextWrapping="Wrap"/>

											</RadioButton>

										</DataTemplate>
									</ItemsControl.ItemTemplate>

								</ItemsControl>

							</StackPanel>

						</Border>

					</DataTemplate>
				</ContentControl.ContentTemplate>

			</ContentControl>

		</ScrollViewer>

	</Border>

    </DockPanel>
</Window>
