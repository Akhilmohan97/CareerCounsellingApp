<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
    x:Class="CareerCounsellingApp.AssessmentWindow"
    xmlns:model="using:CareerCounsellingApp.Models"
    xmlns:vm="using:CareerCounsellingApp.ViewModels"
    xmlns:converters="using:CareerCounsellingApp.Converters"
    x:DataType="vm:AssessmentViewModel"
    Width="1000"
    Height="800"
    Title="Career Assessment"
    Background="{StaticResource BackgroundBrush}"
    WindowStartupLocation="CenterScreen">

<Window.Resources>
    <converters:ObjectEqualityConverter x:Key="ObjectEqualityConverter"/>
	<converters:LanguageConverter x:Key="LanguageConverter"/>
</Window.Resources>
    
<DockPanel>
      <!-- Header -->
      <Border DockPanel.Dock="Top"
              Background="{StaticResource PrimaryBrush}"
              Padding="30,20">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
          <!-- Previous Button -->
          <Button Grid.Column="0"
                  Command="{Binding PreviousQuestionCommand}"
                  Width="45"
                  Height="45"
                  CornerRadius="4"
                  Background="White"
                  Foreground="{StaticResource PrimaryBrush}"
                  BorderThickness="0"
                  ToolTip.Tip="Previous Question"
                  Cursor="Hand">
            <TextBlock Text="◀" FontSize="18" FontWeight="Bold"/>
          </Button>

          <!-- Title and Progress Info -->
          <StackPanel Grid.Column="1" Margin="20,0,20,0" VerticalAlignment="Center">
            <TextBlock Text="Career Assessment"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="White"/>
            <TextBlock Text="{Binding CurrentQuestionNumber, StringFormat='Question {0} of '}"
                       FontSize="13"
                       Foreground="White"
                       Opacity="0.9"
                       Margin="0,8,0,0"/>
          </StackPanel>

          <!-- Language Toggle -->
          <Border Grid.Column="2"
                  Width="150"
                  Height="36"
                  CornerRadius="18"
                  Background="#202938"
                  BorderBrush="#3A4659"
                  BorderThickness="1"
                  Padding="3"
                  VerticalAlignment="Center">
            <Grid ColumnDefinitions="*,*">
              <!-- Selected background -->
              <Border Grid.Column="0"
                      CornerRadius="15"
                      Background="#2563EB">
                <Border.IsVisible>
                  <Binding Path="!UseMalayalam"/>
                </Border.IsVisible>
              </Border>

              <Border Grid.Column="1"
                      CornerRadius="15"
                      Background="#2563EB">
                <Border.IsVisible>
                  <Binding Path="UseMalayalam"/>
                </Border.IsVisible>
              </Border>

              <ToggleButton Grid.Column="0"
                            IsChecked="{Binding !UseMalayalam}"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="White"
                            FontSize="11"
                            FontWeight="SemiBold">
                <TextBlock Text="English"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
              </ToggleButton>

              <ToggleButton Grid.Column="1"
                            IsChecked="{Binding UseMalayalam}"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="White"
                            FontSize="11"
                            FontWeight="SemiBold">
                <TextBlock Text="മലയാളം"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
              </ToggleButton>
            </Grid>
          </Border>
          
          <!-- Next Button -->
          <Button Grid.Column="3"
                  Command="{Binding NextQuestionCommand}"
                  Width="45"
                  Height="45"
                  CornerRadius="4"
                  Background="White"
                  Foreground="{StaticResource PrimaryBrush}"
                  BorderThickness="0"
                  ToolTip.Tip="Next Question"
                  Cursor="Hand"
                  Margin="20,0,0,0">
            <TextBlock Text="▶" FontSize="18" FontWeight="Bold"/>
          </Button>
        </Grid>
      </Border>

      <!-- Submit Button -->
      <Border DockPanel.Dock="Bottom"
              Background="{StaticResource SurfaceBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="0,1,0,0"
              Padding="30,20">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
          <!-- Progress Section -->
          <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="8">
            <TextBlock Text="Overall Progress"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding ProgressText}"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="#2563EB"/>
            <ProgressBar Value="{Binding AnsweredCount}"
                         Maximum="{Binding TotalQuestions}"
                         Height="8"
                         CornerRadius="4"
                         Foreground="#2563EB"
                         Background="#E5E7EB"/>
          </StackPanel>

          <!-- Submit Button -->
          <Button Grid.Column="1"
                  Height="45"
                  Foreground="White"
                  FontSize="15"
                  FontWeight="SemiBold"
                  Command="{Binding SubmitAssessmentCommand}"
                  Cursor="Hand"
                  Classes="accent">
            <TextBlock Text="Submit Assessment"/>
          </Button>
        </Grid>
      </Border>

      <!-- Questions Content - Single Question at a Time -->
      <Border Padding="30">
        <ScrollViewer>
          <ContentPresenter Content="{Binding CurrentQuestion}">
            <ContentPresenter.ContentTemplate>
              <DataTemplate x:DataType="model:AssessmentQuestion">
                <Border Padding="40"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        BoxShadow="0 2 8 #00000010">
                  <StackPanel Spacing="25">
                    <!-- Question Header with Number -->
                    <StackPanel Spacing="15">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0"
                                Background="{StaticResource PrimaryBrush}"
                                CornerRadius="6"
                                Padding="12,8"
                                HorizontalAlignment="Left">
                          <TextBlock Text="{Binding Number, StringFormat='Question {0}'}"
                                     FontSize="14"
                                     FontWeight="Bold"
                                     Foreground="White"/>
                        </Border>
                        
                        <!-- Answered indicator -->
                        <Border Grid.Column="2"
                                Background="#4CAF50"
                                CornerRadius="6"
                                Padding="12,8"
                                IsVisible="{Binding SelectedOption, Converter={x:Static ObjectConverters.IsNotNull}}">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="✓"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                            <TextBlock Text="Answered"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="White"/>
                          </StackPanel>
                        </Border>
                      </Grid>
                      
                      <TextBlock FontSize="20"
                                 FontWeight="SemiBold"
                                 Text="{Binding DisplayQuestionText}"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 TextWrapping="Wrap"
                                 LineHeight="28"/>

                      <Border Background="{StaticResource BackgroundBrush}"
                              BorderBrush="{StaticResource BorderBrush}"
                              BorderThickness="1"
                              CornerRadius="6"
                              Padding="12"
                              IsVisible="{Binding HasQuestionImage}">
                        <Image Source="{Binding QuestionImage}"
                               MaxHeight="400"
                               Stretch="Uniform"/>
                      </Border>
                    </StackPanel>

                    <!-- Radio Button Options -->
                    <Border Background="{StaticResource BackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="20">
                      <StackPanel Spacing="8">
                        <TextBlock Text="Select your answer:"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,12"/>
                        <ItemsControl ItemsSource="{Binding Options}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Spacing="10"/>
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="model:AssessmentOption">
                              <Border Background="{StaticResource BackgroundBrush}"
                                      BorderBrush="{StaticResource BorderBrush}"
                                      BorderThickness="2"
                                      CornerRadius="6"
                                      Padding="2">
                                <RadioButton GroupName="{Binding Option.QuestionId}"
                                             Tag="{Binding Option}"
                                             Click="RadioButton_Click"
                                             Padding="12,10"
                                             Cursor="Hand">
                                  <RadioButton.Content>
                                    <TextBlock Text="{Binding DisplayText}"
                                               FontSize="15"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextWrapping="Wrap"
                                               LineHeight="22"/>
                                  </RadioButton.Content>
                                </RadioButton>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ContentPresenter.ContentTemplate>
          </ContentPresenter>
        </ScrollViewer>
      </Border>

    </DockPanel>
</Window>
