<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CareerCounsellingApp.ViewModels"
    x:Class="CareerCounsellingApp.Views.MainWindow"
    x:DataType="vm:MainWindowViewModel"
    Width="950"
    Height="1000"
    Title="Career Counselling System"
    Background="#E8EEF7"
    WindowStartupLocation="CenterScreen">

    <Grid ColumnDefinitions="2*,2.5*">

        <!-- LEFT PANEL - Modern Gradient -->
        <Border Grid.Column="0">

            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#1E3A8A"/>
                    <GradientStop Offset="0.5" Color="#2563EB"/>
                    <GradientStop Offset="1" Color="#1D3A9E"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>

                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="330">

                    <Image
                        Source="/Assets/logo.png"
                        Stretch="Uniform"
                        Margin="0,0,0,25"
                        Opacity="0.95"/>

                    <TextBlock
                        Text="Career Counselling System"
                        FontSize="32"
                        FontWeight="Bold"
                        Foreground="White"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        LetterSpacing="0.5"/>

                    <TextBlock
                        Margin="0,10,0,0"
                        Text="Discover Your Future With Confidence"
                        FontSize="16"
                        Foreground="#E0E7FF"
                        TextAlignment="Center"
                        Opacity="0.95"/>

                    <Border
                        Margin="0,30"
                        Height="1"
                        Background="White"
                        Opacity="0.25"/>

                    <TextBlock
                        Text="Professional Career Guidance Platform"
                        FontSize="15"
                        Foreground="White"
                        Opacity="0.85"
                        TextAlignment="Center"/>

                    <TextBlock
                        Margin="0,5"
                        Text="Version 3.0.2"
                        FontSize="13"
                        Foreground="White"
                        Opacity="0.75"
                        TextAlignment="Center"/>

                </StackPanel>

                <!-- Footer -->

                <StackPanel
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,25">

                    <TextBlock
                        Text="Powered by"
                        HorizontalAlignment="Center"
                        Foreground="White"
                        Opacity="0.7"
                        FontSize="12"/>

                    <TextBlock
                        Text="www.saikiranz.in"
                        HorizontalAlignment="Center"
                        Foreground="White"
                        FontWeight="SemiBold"
                        FontSize="14"
                        Opacity="0.9"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- RIGHT PANEL - Glass Morphism -->

        <Grid Grid.Column="1" Background="#F0F4F9">

            <Border
                Width="420"
                Padding="40"
                CornerRadius="20"
                Background="#FFFFFF"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BoxShadow="0 20 40 #2563EB15, 0 2 8 #00000010"
                BorderBrush="#E8EEF7"
                BorderThickness="1">

                <StackPanel Spacing="20">

                    <TextBlock
                        Text="Welcome 👋"
                        FontSize="30"
                        FontWeight="Bold"
                        Foreground="#1A202C"
                        LetterSpacing="0.3"/>

                    <TextBlock
                        Text="Sign in to continue your assessment journey"
                        FontSize="14"
                        Foreground="#718096"
                        LineHeight="1.5"/>

                    <Border
                        Height="1.5"
                        Background="#E8EEF7"
                        Margin="0,5,0,10"/>

                    <!-- USERNAME -->

                    <StackPanel Spacing="6">

                        <TextBlock
                            Text="👤 Username"
                            FontWeight="SemiBold"
                            Foreground="#2D3748"
                            FontSize="13"/>

                        <TextBox
                            Height="44"
                            Padding="12,10"
                            FontSize="14"
                            Text="{Binding Username}"
                            PlaceholderText="Enter username"
                            Background="#F7FAFC"
                            Foreground="#1A202C"
                            BorderBrush="#CBD5E0"
                            BorderThickness="1"
                            CornerRadius="10"/>

                    </StackPanel>

                    <!-- PASSWORD -->

                    <StackPanel Spacing="6">

                        <TextBlock
                            Text="🔒 Password"
                            FontWeight="SemiBold"
                            Foreground="#2D3748"
                            FontSize="13"/>

                        <TextBox
                            Height="44"
                            Padding="12,10"
                            PasswordChar="*"
                            FontSize="14"
                            Text="{Binding Password}"
                            PlaceholderText="Enter password"
                            Background="#F7FAFC"
                            Foreground="#1A202C"
                            BorderBrush="#CBD5E0"
                            BorderThickness="1"
                            CornerRadius="10"/>

                    </StackPanel>

                    <!-- Loading -->

                    <StackPanel
                        IsVisible="{Binding IsLoading}"
                        Spacing="8">

                        <TextBlock
                            Text="Signing in..."
                            FontWeight="SemiBold"
                            Foreground="#2D3748"/>

                        <ProgressBar
                            IsIndeterminate="True"
                            Height="4"
                            CornerRadius="2"
                            Foreground="#2563EB"
                            Background="#E8EEF7"/>

                    </StackPanel>

                    <!-- Buttons -->

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="12"
                        Margin="0,5,0,0">

                        <Button
                            Grid.Column="0"
                            Height="46"
                            Command="{Binding LoginCommand}"
                            IsEnabled="{Binding !IsLoading}"
                            Background="#2563EB"
                            Foreground="White"
                            FontWeight="Bold"
                            CornerRadius="10"
                            BorderBrush="#1E40AF"
                            BorderThickness="1">
                            <TextBlock Text="🔐 Sign In" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <Button
                            Grid.Column="1"
                            Height="46"
                            Command="{Binding ClearCommand}"
                            IsEnabled="{Binding !IsLoading}"
                            Background="#F7FAFC"
                            Foreground="#2D3748"
                            FontWeight="Bold"
                            CornerRadius="10"
                            BorderBrush="#CBD5E0"
                            BorderThickness="1">
                            <TextBlock Text="🗑 Clear" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                    </Grid>

                    <!-- Error -->

                    <TextBlock
                        Foreground="#DC2626"
                        FontSize="13"
                        Text="{Binding Message}"
                        TextWrapping="Wrap"
                        IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        Opacity="0.9"/>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</Window>